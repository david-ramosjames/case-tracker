NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for provisioning user roles on first Google sign-in.
# Never expose this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# App URL used for OAuth redirectTo — must match Supabase Redirect URLs allowlist.
# Local: http://localhost:3000  |  Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# DocketFlow app URL for "Open in DocketFlow" links on case detail (e.g. https://your-docketflow.vercel.app)
NEXT_PUBLIC_DOCKETFLOW_URL=
# Shared secret for Case Tracker ↔ DocketFlow server callbacks
# (CT → DF calendar reconcile; DF → CT Slack topic sync after reassignment).
# Falls back to CRON_SECRET if unset.
DOCKETFLOW_INTERNAL_API_SECRET=

# When true, rewrite full structured Slack topics on stage/language/Eve/assignment changes.
# Default off — use Settings → Update Slack topic for a specific case first.
# SLACK_TOPIC_AUTO_SYNC=true

# Slack (optional) — see docs/SLACK_SETUP.md
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# e.g. https://your-workspace.slack.com (for Open in Slack links on case detail)
NEXT_PUBLIC_SLACK_WORKSPACE_URL=
CRON_SECRET=
SLACK_REMINDER_COOLDOWN_DAYS=3
# Comma-separated non-case channels to skip in #daily-pulse fan-out (lead-calls is always ignored)
# SLACK_PULSE_IGNORED_CHANNELS=

# Google Sheet: Case #, Slack Channel, Status, Slack Channel ID (columns B, A, F, G)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_CHANNEL_RANGE=Sheet1!A:H

# RJL Cases Disbursing: B = pending (blank when disbursed), C = Case #, H = Settlement Date, Z = Date Disbursed
GOOGLE_SHEETS_SETTLEMENT_SPREADSHEET_ID=1FxPc2lu6eCFqFw-lDGSc0NChEFq531-yApvTcovwH2M
GOOGLE_SHEETS_SETTLEMENT_RANGE=RJL Cases Disbursing!A:Z
